# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=app
# Required by hosted MySQL-compatible databases such as TiDB Cloud Starter
DB_SSL=false
# DB_CA_PATH=/absolute/path/to/ca.pem
# DB_CONNECTION_LIMIT=5

# Optional: required only by scripts/fetchTopPicksImages.js
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
# TOP_PICK_IMAGE_LIMIT=100

# Optional Swiggy Builders Club MCP overrides
# FRONTEND_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SWIGGY_AUTH_URL=https://mcp.swiggy.com/auth
# SWIGGY_MCP_URL=https://mcp.swiggy.com/food
# SWIGGY_CLIENT_ID=
# SWIGGY_REDIRECT_URI=http://localhost:5000/api/platforms/swiggy/auth/callback
# Production defaults keep all shared-account tools disabled. Enable only after
# setting a strong ADMIN_API_KEY and understanding the shared-cart implications.
# ENABLE_SWIGGY_ADMIN_TOOLS=false
# ENABLE_PUBLIC_LIVE_PRICE_CHECK=false
# ADMIN_API_KEY=replace_with_a_long_random_secret

# Lucknow live catalog. Map each fixed area slug to a saved Swiggy address ID.
# LUCKNOW_AREA_ADDRESS_IDS={"rajajipuram":"addr_...","uttardhona":"addr_..."}
# LUCKNOW_SYNC_ENABLED=false
# LUCKNOW_SYNC_ON_START=false
# LUCKNOW_SYNC_INTERVAL_HOURS=12
# LUCKNOW_SYNC_DELAY_MS=750
# LUCKNOW_SYNC_SEARCH_TERMS=biryani,pizza,burger,north indian,south indian,chinese,dessert
# LUCKNOW_MAX_RESTAURANTS_PER_AREA=20
# LUCKNOW_MAX_ITEMS_PER_RESTAURANT=80
